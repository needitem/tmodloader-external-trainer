  <LuaScript>-- ══════════════════════════════════════════════
-- Terraria CT - Compact Mode + Auto-Hook  
-- ══════════════════════════════════════════════

-- [1] COMPACT / FULL VIEW TOGGLE
function cycleFullCompact(sender, force)
    local form = getMainForm()
    local state = not (compactmenuitem.Caption == 'Compact View Mode')
    if force ~= nil then state = not force end
    
    compactmenuitem.Caption = state and 'Compact View Mode' or 'Full View Mode'
    form.Splitter1.Visible = state
    form.Panel4.Visible = state
    form.Panel5.Visible = state
end

-- [2] CUSTOM MENU ITEMS
function addCustomInterface()
    if customInterfaceAdded then return end
    local parent = getMainForm().Menu.Items

    -- Discord link
    local discItem = createMenuItem(parent)
    parent.add(discItem)
    discItem.Caption = "UC"
    discItem.OnClick = function() shellExecute("https://www.unknowncheats.me/forum/members/2529642.html") end

    -- FearLess link
    local fearItem = createMenuItem(parent)
    parent.add(fearItem)
    fearItem.Caption = "FearLess"
    fearItem.OnClick = function() shellExecute("http://fearlessrevolution.com/") end

    -- Compact Mode toggle
    compactmenuitem = createMenuItem(parent)
    parent.add(compactmenuitem)
    compactmenuitem.Caption = 'Compact View Mode'
    compactmenuitem.OnClick = cycleFullCompact
    
    customInterfaceAdded = true
end

addCustomInterface()
cycleFullCompact(nil, true)

-- [3] AUTO-ATTACH TO Terraria.exe
local autoAttachTimer = createTimer(nil)
autoAttachTimer.Interval = 500
autoAttachTimer.OnTimer = function(t)
  if getProcessIDFromProcessName("Terraria.exe") then
    openProcess("Terraria.exe")
    t.destroy()
  end
end
</LuaScript>
