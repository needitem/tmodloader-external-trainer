              <ID>149</ID>
              <Description>"🍀 Luck System"</Description>
              <Options moHideChildren="1"/>
              <Color>FFD700</Color>
              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>7000</ID>
                  <Description>"🍀 Force Luck Value (enable to override, set value below)"</Description>
                  <Color>00FF00</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
alloc(nm_LuckForce,256)
alloc(forcedLuckVal,4)
registersymbol(forcedLuckVal)
label(ret_LuckForce)

forcedLuckVal:
  dd (float)1.0

nm_LuckForce:
  push eax
  mov eax,[forcedLuckVal]
  mov [esi+00000680],eax
  pop eax
  fld dword ptr [esi+00000680]
  jmp ret_LuckForce

Terraria.Player::RecalculateLuck+FD:
  jmp nm_LuckForce
  nop
ret_LuckForce:

[DISABLE]
Terraria.Player::RecalculateLuck+FD:
  db D9 86 80 06 00 00
unregistersymbol(forcedLuckVal)
dealloc(forcedLuckVal)
dealloc(nm_LuckForce)
</AssemblerScript>
