{$lua}
if not buffTimers then buffTimers = {} end
local function clear_PotionSickness()
  local p = readInteger("myPlayer")
  if not p or p == 0 then return end
  local aID = readInteger(p + 0xC8)
  local aTm = readInteger(p + 0xCC)
  if not aID or aID == 0 then return end
  -- Clear buff 21 (Potion Sickness) from buff array
  for i=0,43 do
    if readInteger(aID+8+i*4) == 21 then
      writeInteger(aID+8+i*4, 0)
      writeInteger(aTm+8+i*4, 0)
    end
  end
  -- Also zero the potion delay timers on the player
  writeInteger(p + 0x3C4, 0)  -- potionDelay counter
  writeInteger(p + 0x58C, 0)  -- potionDelayTime
end
local t = createTimer(nil, false)
t.Interval = 200
t.OnTimer = clear_PotionSickness
t.Enabled = true
buffTimers["NoPotSick"] = t
