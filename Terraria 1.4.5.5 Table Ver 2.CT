<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="46">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"🔑 Terraria 1.4.4.5 — Made with ❤️ by zey"</Description>
      <Color>FF0080</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : Terraria.exe
  Version: 1.4.5.5 (Steam)
  Author : Aero (original), parnumees2 (get_LocalPlayer), Zey (integration)

  FindPlayer via get_LocalPlayer - guaranteed local player in all modes.
  Works in singleplayer, host, guest, and dedicated servers.
  No manual index needed.
}

[ENABLE]
define(address, Terraria.Main::get_LocalPlayer+10)
define(bytes, 8B 44 90 08 C3)

assert(address, bytes)

alloc(newmem, $1000)
alloc(myPlayer, 4)

label(return)

registersymbol(myPlayer)

newmem:
  mov eax,[eax+edx*4+08]
  mov [myPlayer],eax
  ret

myPlayer:
  dd 0

address:
  jmp newmem
return:

[DISABLE]
address:
  db 8B 44 90 08 C3

unregistersymbol(myPlayer)
dealloc(newmem)
dealloc(myPlayer)
</AssemblerScript>
