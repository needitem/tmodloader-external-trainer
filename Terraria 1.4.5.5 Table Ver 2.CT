alloc(modePointer,4)
alloc(mode,1)
label(JourneyModeRet)
label(SkipToggleBackup)
registersymbol(JourneyModeAob JourneyModeOg mode modePointer)

JourneyModeOg:
readmem(JourneyModeAob,7)

modePointer:
dd 00

mode:
db FF

JourneyModeCode:
mov ecx, eax
add ecx, [JourneyModeOg+2]
mov [modePointer], ecx
cmp byte ptr [mode], FF
jne SkipToggleBackup
mov al, [ecx]
mov [mode], al

SkipToggleBackup:
mov byte ptr [ecx], 3
readmem(JourneyModeAob,7)
jmp JourneyModeRet

JourneyModeAob:
jmp JourneyModeCode
nop 2
JourneyModeRet:

