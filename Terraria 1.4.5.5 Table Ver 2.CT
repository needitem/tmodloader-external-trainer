                  <AssemblerScript>[ENABLE]
{$lua}
if not buffTimers then buffTimers = {} end
local function clear_ManaSickness()
  local p = readInteger("myPlayer")
  if not p or p == 0 then return end
  local aID = readInteger(p + 0xC8)
  local aTm = readInteger(p + 0xCC)
  if not aID or aID == 0 then return end
  for i=0,43 do
    if readInteger(aID+8+i*4) == 94 then
      writeInteger(aID+8+i*4, 0)
      writeInteger(aTm+8+i*4, 0)
    end
  end
end
local t = createTimer(nil, false)
t.Interval = 200
t.OnTimer = clear_ManaSickness
t.Enabled = true
buffTimers["NoManaSick"] = t
{$asm}

[DISABLE]
{$lua}
if buffTimers and buffTimers["NoManaSick"] then
  buffTimers["NoManaSick"].Enabled = false
  buffTimers["NoManaSick"].destroy()
  buffTimers["NoManaSick"] = nil
end
{$asm}
</AssemblerScript>
