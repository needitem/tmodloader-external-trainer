<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Diag</AssemblyName>
    <RootNamespace>TerrariaTrainer</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reuse the trainer's engine source directly. -->
    <Compile Include="..\src\Memory\*.cs" />
    <Compile Include="..\src\Core\*.cs" />
    <Compile Include="..\src\Cheats\*.cs" />
    <Compile Include="..\src\Tml\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="4.0.726401" />
    <PackageReference Include="Iced" Version="1.21.0" />
  </ItemGroup>

</Project>
